# Public site URL (used for sitemap and canonical URLs).
NEXT_PUBLIC_APP_URL="https://bicyclebutler.cc"

# Email service (Resend) for demo requests.
# Leave RESEND_API_KEY empty in development: leads are accepted locally but not emailed.
RESEND_API_KEY=""
DEMO_FROM_EMAIL="demos@bicyclebutler.cc"
DEMO_TO_EMAIL="demos@bicyclebutler.cc"

# Set to "1" to skip environment validation (e.g. local dev without keys).
# SKIP_ENV_VALIDATION=1
